# ---------------------------------------------------------------------------
# GbanaB2B environment. Copy to .env.local and fill in. NEVER commit real values.
# Only NEXT_PUBLIC_* variables reach the browser — keep secrets without that prefix.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) — or the legacy anon key below. Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security. Used by webhooks/jobs (Phase 5+).
# Secret key (sb_secret_…) — or the legacy service-role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment providers — SERVER ONLY. Filled in Phase 5, from verified provider docs.
MTN_API_URL=
MTN_API_KEY=
MTN_API_SECRET=
ORANGE_API_URL=
ORANGE_API_KEY=
ORANGE_API_SECRET=

# Test payment provider (no real money). Random 32+ chars, server only. Generate with: openssl rand -hex 32
SANDBOX_WEBHOOK_SECRET=

# Web Push (VAPID). Public key may be exposed; private key is SERVER ONLY.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@example.com

# debug | info | warn | error
LOG_LEVEL=info

# TEMPORARY: email+password sign-in for pre-provisioned accounts while SMS is unavailable.
# Set to true only until phone OTP works, then remove.
DEMO_ACCESS_ENABLED=false
